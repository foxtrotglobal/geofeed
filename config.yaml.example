# GeoFeed Configuration
# Copy this file to config.yaml and fill in your API keys.
# Alternatively, set environment variables (e.g. YOUTUBE_API_KEY).

youtube:
  api_key: ""          # Free: https://console.cloud.google.com → YouTube Data API v3

flickr:
  api_key: ""          # Free: https://www.flickr.com/services/apps/create/

instagram:
  session_cookie: ""   # Your Instagram cookie string (see README)

twitter:
  bearer_token: ""     # https://developer.twitter.com → API v2 bearer token

tiktok:
  # No API key needed — uses web scraping with reverse-geocoded place names
  ms_token: ""   # From browser: DevTools → Application → Cookies → tiktok.com → msToken
  ttwid: ""      # From browser: DevTools → Application → Cookies → tiktok.com → ttwid

bluesky:
  # No credentials needed for public search
  identifier: ""       # Optional: your handle (e.g. you.bsky.social) for higher rate limits
  app_password: ""     # Optional: Bluesky app password (Settings → App Passwords)

mastodon:
  instance: "mastodon.social"  # Mastodon instance to search (default: mastodon.social)
  access_token: ""             # Optional: OAuth token for higher rate limits

snapchat:
  # Requires Playwright (pip install playwright && playwright install chromium)
  # AND a Snapchat session cookie from map.snapchat.com
  # 1. Log in to Snapchat in Chrome and visit https://map.snapchat.com/
  # 2. F12 -> Network -> any map.snapchat.com request -> Headers -> copy 'cookie:' value
  # 3. Paste below (same format as Instagram session_cookie)
  session_cookie: ""

facebook:
  app_id: ""           # https://developers.facebook.com → Create App → App ID
  app_secret: ""       # App Secret from the same page
  # Note: public post search was removed in Graph API v2.0.
  # This searches nearby Places and their public feeds.

telegram:
  # No credentials needed — scrapes public channels via t.me/s/
  bot_token: ""        # Optional: Bot token from @BotFather for extended lookup
  channels:            # Optional: override the default channel list
    # - irna_ir
    # - bbcpersian
    # - mychannel

aparat:
  # No credentials needed — uses Aparat public search API

rubika:
  # No credentials needed — searches Rubika public content

reddit:
  # No credentials needed for public search
  client_id: ""        # Optional: Reddit app client ID for higher rate limits
  client_secret: ""    # Optional: Reddit app client secret
  subreddits: ""       # Optional: comma-separated list to override defaults
                       # Default: iran,tehran,middleeast,worldnews,news
